{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "author": "ThanhVu Nguyen",
  "developer": {
    "name": "ThanhVu Nguyen"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "date2cal@roars.dev",
      "strict_min_version": "137.0",
      "strict_max_version": "156.*"
    }
  },
  "message_display_action": {
    "default_popup": "create_event_button/pop_up_button.html",
    "default_title": "__MSG_messageActionTitle__",
    "default_icon": "images/calendar-light.svg",
    "theme_icons": [
      {
        "light": "images/calendar-dark.svg",
        "dark": "images/calendar-light.svg",
        "size": 16
      }
    ]
  },
  "background": {
    "scripts": [
      "background/register_content_script_injector.js",
      "background/register_message_listeners.js",
      "background/register_context_menu.js"
    ],
    "type": "module"
  },
  "icons": {
    "64": "images/icon-64.png",
    "32": "images/icon-32.png",
    "16": "images/icon-16.png"
  },
  "permissions": [
    "messagesRead",
    "scripting",
    "storage",
    "menus"
  ],
  "experiment_apis": {
    "calendar_calendars": {
      "schema": "experiments/calendar-bridge/schema/calendars.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "experiments/calendar-bridge/parent/calendars.js",
        "events": [
          "startup"
        ],
        "paths": [
          [
            "calendar",
            "calendars"
          ]
        ]
      }
    },
    "calendar_items": {
      "schema": "experiments/calendar-bridge/schema/items.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "experiments/calendar-bridge/parent/items.js",
        "events": [
          "startup"
        ],
        "paths": [
          [
            "calendar",
            "items"
          ]
        ]
      }
    },
    "calendar_timezones": {
      "schema": "experiments/calendar-bridge/schema/timezones.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "experiments/calendar-bridge/parent/timezones.js",
        "paths": [
          [
            "calendar",
            "timezones"
          ]
        ]
      },
      "child": {
        "scopes": [
          "addon_child"
        ],
        "script": "experiments/calendar-bridge/child/timezones.js",
        "paths": [
          [
            "calendar",
            "timezones"
          ]
        ]
      }
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "default_locale": "en"
}
